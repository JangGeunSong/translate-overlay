{
  "name": "context-reader-overlay",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "qa:public": "node scripts/public-site-qa.mjs",
    "test:backend": "vitest run server",
    "test:provider:real": "node server/real-provider-smoke.mjs",
    "backend:start": "node server/index.mjs",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run validate:manifest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.322",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
