NODE_ENV=production
INTERPRETATION_PROVIDER=openai
OPENAI_API_KEY=replace-with-a-server-side-secret
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_RETRIES=1
PORT=8787
ALLOWED_EXTENSION_ORIGINS=chrome-extension://replace-with-production-extension-id
PROVIDER_TIMEOUT_MS=12000
RATE_LIMIT_PER_MINUTE=30
EXPOSE_PROVIDER_DIAGNOSTICS=0
CONTEXT_READER_API_ORIGIN=https://reader-api.example.com
